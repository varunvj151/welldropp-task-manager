{
  "buildCommand": "vite build && esbuild api/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/handler.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/handler.cjs": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler.cjs" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
