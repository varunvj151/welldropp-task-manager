{
  "buildCommand": "vite build && esbuild api/index.cts --bundle --platform=node --format=cjs --packages=external --outfile=api/handler.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
